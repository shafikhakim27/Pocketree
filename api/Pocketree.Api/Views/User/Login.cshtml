@model ADproject.Models.DTOs.UserLoginDto

<div class="landing-container d-flex align-items-center justify-content-center">
    <div class="card login-card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-5 p-5 bg-white">
                <h2 class="fw-bold green-text mb-4">POCKETREE</h2>

                <div class="container mt-4">
                    <partial name="_Alerts" />

                    <div class="row">
                    </div>
                </div>

                <form asp-controller="User" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3 input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-leaf"></i></span>
                        <input asp-for="Username" class="form-control border-start-0" placeholder="Username" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>

                    <div class="mb-4 input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="Password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>

                    <button type="submit" class="btn btn-green w-100 rounded-pill py-2 fw-bold">LOGIN</button>

                    <div class="d-flex justify-content-between mt-3 small">
                        <a asp-controller="User" asp-action="Register" class="text-muted text-decoration-none">Sign Up</a>
                    </div>

                    <div class="mt-2 d-flex justify-content-between">
                        <a href="#" onclick="forgotPassword()" class="text-sm text-success">Forgot Password?</a>
                        <a href="#" onclick="openQueryModal()" class="text-sm text-muted">Need Help? Contact Support</a>
                    </div>
                </form>
            </div>

            <div class="col-md-7 green-gradient-bg d-flex flex-column align-items-center justify-content-center p-5 text-white">
                <h1 class="fw-bold mb-4">GLOBAL GREEN MOVEMENT</h1>
                <div id="map-stage" style="position: relative; display: inline-block;">
                
                    <img src="~/images/mission/sahara.png" 
                             asp-append-version="true" 
                             alt="Green World Map" 
                             id="base-map"
                             class="img-fluid mb-4" 
                             style="max-height: 400px; display: block;" />
                    <div id="tree-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;">
                    </div>
                </div>
            
                <button class="btn btn-light green-text rounded-pill px-5 fw-bold mb-3">Join the movement now!</button>
                <div class="download-badge bg-white text-dark rounded-pill px-3 py-1 small shadow-sm">
                    Download our Green App! <img src="~/images/app-stores.png" height="20" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="queryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Contact Support</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input type="text" id="queryIdentifier" class="form-control" placeholder="Identify your account by entering your username or email address">
                </div>
                <div class="mb-3">
                    <label class="form-label">Your Query</label>
                    <textarea id="queryText" class="form-control" rows="4" placeholder="How can we help?"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="submitQuery()">Submit</button>
            </div>
        </div>
    </div>
</div>


<script>
    async function forgotPassword() {
        const username = document.getElementById("Username").value;

        if (!username) {
            alert("Please enter your username. The temporary password will be sent to your registered email address.");
            return;
        }

        try {
            const response = await fetch('/User/PasswordReset', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `username=${encodeURIComponent(username)}`
            });

            if (response.ok) {
                alert("A temporary 8-digit password has been sent to your email. Please use it to log in.");
            } else {
                const error = await response.text();
                alert("Error: " + error);
            }
        } catch (err) {
            console.error("Connection failed", err);
            alert("Could not connect to the server. Check your internet connection.");
        }
    }

    function openQueryModal() {
        var myModal = new bootstrap.Modal(document.getElementById('queryModal'));
        myModal.show();
    }

    async function submitQuery() {
        const id = document.getElementById('queryIdentifier').value;
        const text = document.getElementById('queryText').value;

        if(!id || !text) return alert("Please fill in all fields.");

        const response = await fetch(`/User/SubmitQuery?identifier=${encodeURIComponent(id)}&userQuery=${encodeURIComponent(text)}`, {
            method: 'POST'
        });

        if(response.ok) {
            alert("Submitted successfully! Our admin will review and get back to you on your query.");
            bootstrap.Modal.getInstance(document.getElementById('queryModal')).hide();
        } else {
            alert("Error: User not found.");
        }
    }
</script>